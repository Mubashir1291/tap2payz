    "compilerOptions": {
        "jsx": "react-native",
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true
    },
    "include": [
        "**/*.js",
        "**/*.jsx"
    ],
    "exclude": [
        "**/node_modules",
        "**/Pods"
    ]
}